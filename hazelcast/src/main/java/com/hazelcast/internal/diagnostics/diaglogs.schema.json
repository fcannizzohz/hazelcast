{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazelcast.com/schemas/diagnostics-log-entry.schema.json",
  "title": "Hazelcast Diagnostics Log Entry",
  "description": "Schema for a single newline-delimited JSON object produced by Hazelcast Diagnostics when DiagnosticsLogFormat.JSON is configured. This schema validates one NDJSON line at a time. It applies to both native JSON output and STANDARD-to-JSON converted output, which must be structurally identical.",
  "$comment": "All top-level name values are known; see the allOf if/then blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epoch",
    "name",
    "content"
  ],
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch time in milliseconds. Required for both native JSON output and converted STANDARD-to-JSON output. Converted output may have second precision with millisecond component 000, but remains structurally identical."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Diagnostics plugin or event discriminator."
    },
    "content": {
      "type": "object",
      "description": "Plugin-specific payload. Always an object, never null."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "BuildInfo"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/buildInfoContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "ConfigProperties"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/stringMap"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "SystemProperties"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/stringMap"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Metric"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/metricContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "EventQueues"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/eventQueuesContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "PendingInvocations"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/pendingInvocationsContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "SlowOperations"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/slowOperationsContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/lifecycleContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "enum": [
              "MemberAdded",
              "MemberRemoved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/membershipContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "enum": [
              "ConnectionAdded",
              "ConnectionRemoved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/connectionContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "ClusterVersionChanged"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/clusterVersionContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "MigrationState"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/migrationStateContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "enum": [
              "MigrationCompleted",
              "MigrationFailed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/replicaMigrationContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "OperationHeartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/heartbeatContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "MemberHeartbeats"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/heartbeatContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "NetworkingImbalance"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/networkingImbalanceContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "OverloadedConnections"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/overloadedConnectionsContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "OperationsProfiler"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/latencyByOperationContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "InvocationProfiler"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/latencyByOperationContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "OperationThreadSamples"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/operationThreadSamplesContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "HazelcastInstance"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/hazelcastInstanceContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Invocations"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/invocationsContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "StoreLatency"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/storeLatencyContent"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "not": {
              "enum": [
                "BuildInfo",
                "ConfigProperties",
                "SystemProperties",
                "Metric",
                "EventQueues",
                "PendingInvocations",
                "SlowOperations",
                "Lifecycle",
                "MemberAdded",
                "MemberRemoved",
                "ConnectionAdded",
                "ConnectionRemoved",
                "ClusterVersionChanged",
                "MigrationState",
                "MigrationCompleted",
                "MigrationFailed",
                "OperationHeartbeat",
                "MemberHeartbeats",
                "NetworkingImbalance",
                "OverloadedConnections",
                "OperationsProfiler",
                "InvocationProfiler",
                "OperationThreadSamples",
                "HazelcastInstance",
                "Invocations",
                "StoreLatency"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/storeLatencyContent"
          }
        }
      }
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "description": "Generic diagnostics section object. Concrete plugin schemas are stricter than this reusable definition.",
      "additionalProperties": true
    },
    "entriesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "textEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "structuredEntry": {
      "type": "object",
      "description": "Generic structured entry produced by writeStructuredEntry(Object... kvPairs).",
      "additionalProperties": true
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "latencyDistributionBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo_us",
        "hi_us",
        "count"
      ],
      "properties": {
        "lo_us": {
          "type": "integer",
          "minimum": 0
        },
        "hi_us": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latencyDistribution": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/latencyDistributionBucket"
      }
    },
    "latencyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "totalTime_us",
        "avg_us",
        "max_us",
        "latency_distribution"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "totalTime_us": {
          "type": "integer",
          "minimum": 0
        },
        "avg_us": {
          "type": "integer",
          "minimum": 0
        },
        "max_us": {
          "type": "integer",
          "minimum": 0
        },
        "latency_distribution": {
          "$ref": "#/$defs/latencyDistribution"
        }
      }
    },
    "buildInfoContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Build",
        "BuildNumber",
        "Revision",
        "Version",
        "SerialVersion",
        "Enterprise"
      ],
      "properties": {
        "Build": {
          "type": "string"
        },
        "BuildNumber": {
          "type": "integer"
        },
        "Revision": {
          "type": "string"
        },
        "UpstreamRevision": {
          "type": "string"
        },
        "Version": {
          "type": "string"
        },
        "SerialVersion": {
          "type": "string"
        },
        "Enterprise": {
          "type": "boolean"
        }
      }
    },
    "metricExceptionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptionClass"
      ],
      "properties": {
        "exceptionClass": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metricObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "description": "Optional metric prefix, e.g. 'jvm.memory'. Omitted when the descriptor has no prefix."
        },
        "metric": {
          "type": "string",
          "description": "Metric name, e.g. 'heap.used'."
        },
        "unit": {
          "type": "string",
          "enum": ["bytes", "ms", "ns", "pct", "count", "boolean", "enum", "us"],
          "description": "Measurement unit. Omitted when the descriptor has no unit."
        },
        "value": {
          "description": "Metric value: a number, or null when no value was collected.",
          "oneOf": [
            {"type": "number"},
            {"type": "null"}
          ]
        },
        "exceptionClass": {
          "type": "string",
          "description": "Exception class name when collection failed. Present instead of value."
        },
        "message": {
          "type": ["string", "null"],
          "description": "Exception message. Present when exceptionClass is present."
        }
      }
    },
    "metricContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metricObject"
          },
          "description": "Array of all metrics collected in this cycle."
        }
      }
    },
    "eventQueueSampleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "percentage"
      ],
      "properties": {
        "serviceType": {
          "type": "string",
          "description": "Service type: IMap, ICache, IQueue, ISet, IList. Present for known Hazelcast event types."
        },
        "dataStructureName": {
          "type": "string",
          "description": "Name of the data structure. Present when serviceType is present."
        },
        "eventType": {
          "type": "string",
          "description": "Event type name, or the runnable class name for unknown event types."
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "eventQueueSamplesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eventQueueSampleEntry"
          }
        }
      }
    },
    "eventQueueWorkerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventCount",
        "sampleCount",
        "samples"
      ],
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "$ref": "#/$defs/eventQueueSamplesSection"
        }
      }
    },
    "eventQueuesContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^worker=\\d+$": {
          "$ref": "#/$defs/eventQueueWorkerSection"
        }
      }
    },
    "invocationEntrySimple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "count"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pendingInvocationsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "invocations"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "invocations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/invocationEntrySimple"
              }
            }
          }
        }
      }
    },
    "stackLineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "string"
        }
      }
    },
    "slowInvocationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "duration(ms)",
        "operationDetails"
      ],
      "properties": {
        "startedAt": {
          "type": "integer",
          "minimum": 0
        },
        "duration(ms)": {
          "type": "integer",
          "minimum": 0
        },
        "operationDetails": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stackTraceSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stackLineEntry"
          }
        }
      }
    },
    "slowInvocationsSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slowInvocationEntry"
          }
        }
      }
    },
    "slowOperationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocations",
        "stackTrace",
        "slowInvocations"
      ],
      "properties": {
        "invocations": {
          "type": "integer",
          "minimum": 0
        },
        "stackTrace": {
          "$ref": "#/$defs/stackTraceSection"
        },
        "slowInvocations": {
          "$ref": "#/$defs/slowInvocationsSection"
        }
      }
    },
    "slowOperationsContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "$ref": "#/$defs/slowOperationEntry"
        }
      }
    },
    "lifecycleStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "STARTING",
            "STARTED",
            "SHUTTING_DOWN",
            "SHUTDOWN",
            "MERGING",
            "MERGED",
            "MERGE_FAILED",
            "CLIENT_CONNECTED",
            "CLIENT_DISCONNECTED",
            "CLIENT_CHANGED_CLUSTER"
          ]
        }
      }
    },
    "lifecycleContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/lifecycleStateEntry"
          }
        }
      }
    },
    "memberEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "isThis",
        "isMaster"
      ],
      "properties": {
        "address": {
          "type": "string"
        },
        "isThis": {
          "type": "boolean"
        },
        "isMaster": {
          "type": "boolean"
        }
      }
    },
    "membersSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/memberEntry"
          }
        }
      }
    },
    "membershipContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "Members"
      ],
      "properties": {
        "member": {
          "type": "string"
        },
        "Members": {
          "$ref": "#/$defs/membersSection"
        }
      }
    },
    "connectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteAddress"
      ],
      "properties": {
        "remoteAddress": {
          "type": "string",
          "description": "Remote endpoint address in host:port format."
        }
      }
    },
    "exceptionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptionClass",
        "message"
      ],
      "properties": {
        "exceptionClass": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "closeCauseSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/exceptionEntry"
              },
              {
                "$ref": "#/$defs/textEntry"
              }
            ]
          }
        }
      }
    },
    "connectionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "isAlive"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/connectionEntry"
          }
        },
        "type": {
          "type": "string"
        },
        "isAlive": {
          "type": "boolean"
        },
        "closeReason": {
          "type": "string"
        },
        "CloseCause": {
          "$ref": "#/$defs/closeCauseSection"
        }
      }
    },
    "clusterVersionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      }
    },
    "clusterVersionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/clusterVersionEntry"
          }
        }
      }
    },
    "migrationStateContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTime",
