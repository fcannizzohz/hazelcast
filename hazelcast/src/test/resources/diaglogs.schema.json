{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazelcast.com/schemas/diagnostics-log-entry.schema.json",
  "title": "Hazelcast Diagnostics Log Entry",
  "description": "Schema for a single newline-delimited JSON object produced by Hazelcast Diagnostics when DiagnosticsLogFormat.JSON is configured. This schema validates one NDJSON line at a time. It applies to both native JSON output and STANDARD-to-JSON converted output, which must be structurally identical.",
  "$comment": "Unknown top-level name values are interpreted as StoreLatencyPlugin service names, per the current specification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["epoch", "name", "content"],
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch time in milliseconds. Required for both native JSON output and converted STANDARD-to-JSON output. Converted output may have second precision with millisecond component 000, but remains structurally identical."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Diagnostics plugin or event discriminator. Unknown names are treated as StoreLatencyPlugin service names."
    },
    "content": {
      "type": "object",
      "description": "Plugin-specific payload. Always an object, never null."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "BuildInfo" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/buildInfoContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "ConfigProperties" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/stringMap" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "SystemProperties" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/stringMap" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "Metric" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/metricContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "EventQueues" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/eventQueuesContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "PendingInvocations" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/pendingInvocationsContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "SlowOperations" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/slowOperationsContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "Lifecycle" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/lifecycleContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "enum": ["MemberAdded", "MemberRemoved"] } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/membershipContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "enum": ["ConnectionAdded", "ConnectionRemoved"] } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/connectionContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "ClusterVersionChanged" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/clusterVersionContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "MigrationState" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/migrationStateContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "enum": ["MigrationCompleted", "MigrationFailed"] } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/replicaMigrationContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "OperationHeartbeat" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/heartbeatContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "MemberHeartbeats" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/heartbeatContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "NetworkingImbalance" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/networkingImbalanceContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "OverloadedConnections" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/overloadedConnectionsContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "OperationsProfiler" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/latencyByOperationContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "InvocationProfiler" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/latencyByOperationContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "OperationThreadSamples" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/operationThreadSamplesContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "HazelcastInstance" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/hazelcastInstanceContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": { "name": { "const": "Invocations" } }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/invocationsContent" } }
      }
    },
    {
      "if": {
        "required": ["name"],
        "properties": {
          "name": {
            "not": {
              "enum": [
                "BuildInfo",
                "ConfigProperties",
                "SystemProperties",
                "Metric",
                "EventQueues",
                "PendingInvocations",
                "SlowOperations",
                "Lifecycle",
                "MemberAdded",
                "MemberRemoved",
                "ConnectionAdded",
                "ConnectionRemoved",
                "ClusterVersionChanged",
                "MigrationState",
                "MigrationCompleted",
                "MigrationFailed",
                "OperationHeartbeat",
                "MemberHeartbeats",
                "NetworkingImbalance",
                "OverloadedConnections",
                "OperationsProfiler",
                "InvocationProfiler",
                "OperationThreadSamples",
                "HazelcastInstance",
                "Invocations"
              ]
            }
          }
        }
      },
      "then": {
        "properties": { "content": { "$ref": "#/$defs/storeLatencyContent" } }
      }
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "description": "Generic diagnostics section object. Concrete plugin schemas are stricter than this reusable definition.",
      "additionalProperties": true
    },
    "entriesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "textEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" }
      }
    },
    "structuredEntry": {
      "type": "object",
      "description": "Generic structured entry produced by writeStructuredEntry(Object... kvPairs).",
      "additionalProperties": true
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "latencyDistribution": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "type": "integer", "minimum": 0 }
      }
    },
    "latencyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "totalTime(us)", "avg(us)", "max(us)", "latency-distribution"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "totalTime(us)": { "type": "integer", "minimum": 0 },
        "avg(us)": { "type": "integer", "minimum": 0 },
        "max(us)": { "type": "integer", "minimum": 0 },
        "latency-distribution": { "$ref": "#/$defs/latencyDistribution" }
      }
    },
    "buildInfoContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Build", "BuildNumber", "Revision", "Version", "SerialVersion", "Enterprise"],
      "properties": {
        "Build": { "type": "string" },
        "BuildNumber": { "type": "integer" },
        "Revision": { "type": "string" },
        "UpstreamRevision": { "type": "string" },
        "Version": { "type": "string" },
        "SerialVersion": { "type": "string" },
        "Enterprise": { "type": "boolean" }
      }
    },
    "metricContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "anyOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "eventQueueSampleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "sampleCount", "percentage"],
      "properties": {
        "eventType": { "type": "string" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "eventQueueSamplesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/eventQueueSampleEntry" }
        }
      }
    },
    "eventQueueWorkerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCount", "sampleCount", "samples"],
      "properties": {
        "eventCount": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "samples": { "$ref": "#/$defs/eventQueueSamplesSection" }
      }
    },
    "eventQueuesContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^worker=\\d+$": { "$ref": "#/$defs/eventQueueWorkerSection" }
      }
    },
    "invocationEntrySimple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "count"],
      "properties": {
        "operation": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "pendingInvocationsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "invocations"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "invocations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/invocationEntrySimple" }
            }
          }
        }
      }
    },
    "stackLineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "properties": {
        "line": { "type": "string" }
      }
    },
    "slowInvocationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "duration(ms)", "operationDetails"],
      "properties": {
        "startedAt": { "type": "integer", "minimum": 0 },
        "duration(ms)": { "type": "integer", "minimum": 0 },
        "operationDetails": { "type": ["string", "null"] }
      }
    },
    "stackTraceSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stackLineEntry" }
        }
      }
    },
    "slowInvocationsSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slowInvocationEntry" }
        }
      }
    },
    "slowOperationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocations", "stackTrace", "slowInvocations"],
      "properties": {
        "invocations": { "type": "integer", "minimum": 0 },
        "stackTrace": { "$ref": "#/$defs/stackTraceSection" },
        "slowInvocations": { "$ref": "#/$defs/slowInvocationsSection" }
      }
    },
    "slowOperationsContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/slowOperationEntry" }
      }
    },
    "lifecycleStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "STARTING",
            "STARTED",
            "SHUTTING_DOWN",
            "SHUTDOWN",
            "MERGING",
            "MERGED",
            "MERGE_FAILED",
            "CLIENT_CONNECTED",
            "CLIENT_DISCONNECTED",
            "CLIENT_CHANGED_CLUSTER"
          ]
        }
      }
    },
    "lifecycleContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/lifecycleStateEntry" }
        }
      }
    },
    "memberEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "isThis", "isMaster"],
      "properties": {
        "address": { "type": "string" },
        "isThis": { "type": "boolean" },
        "isMaster": { "type": "boolean" }
      }
    },
    "membersSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/memberEntry" }
        }
      }
    },
    "membershipContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "Members"],
      "properties": {
        "member": { "type": "string" },
        "Members": { "$ref": "#/$defs/membersSection" }
      }
    },
    "connectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection"],
      "properties": {
        "connection": { "type": "string" }
      }
    },
    "exceptionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionClass", "message"],
      "properties": {
        "exceptionClass": { "type": "string" },
        "message": { "type": ["string", "null"] }
      }
    },
    "closeCauseSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/exceptionEntry" },
              { "$ref": "#/$defs/textEntry" }
            ]
          }
        }
      }
    },
    "connectionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "isAlive"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/connectionEntry" }
        },
        "type": { "type": "string" },
        "isAlive": { "type": "boolean" },
        "closeReason": { "type": "string" },
        "CloseCause": { "$ref": "#/$defs/closeCauseSection" }
      }
    },
    "clusterVersionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string" }
      }
    },
    "clusterVersionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/clusterVersionEntry" }
        }
      }
    },
    "migrationStateContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTime",
        "plannedMigrations",
        "completedMigrations",
        "remainingMigrations",
        "totalElapsedTime(ms)"
      ],
      "properties": {
        "startTime": { "type": "string" },
        "plannedMigrations": { "type": "integer", "minimum": 0 },
        "completedMigrations": { "type": "integer", "minimum": 0 },
        "remainingMigrations": { "type": "integer", "minimum": 0 },
        "totalElapsedTime(ms)": { "type": "integer", "minimum": 0 }
      }
    },
    "replicaMigrationContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "partitionId", "replicaIndex", "elapsedTime(ms)", "MigrationState"],
      "properties": {
        "source": { "type": "string" },
        "destination": { "type": "string" },
        "partitionId": { "type": "integer", "minimum": 0 },
        "replicaIndex": { "type": "integer", "minimum": 0 },
        "elapsedTime(ms)": { "type": "integer", "minimum": 0 },
        "MigrationState": { "$ref": "#/$defs/migrationStateContent" }
      }
    },
    "heartbeatMemberEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "deviation(%)", "noHeartbeat(ms)", "lastHeartbeat(ms)", "now(ms)"],
      "properties": {
        "address": { "type": "string" },
        "deviation(%)": { "type": "number" },
        "noHeartbeat(ms)": { "type": "integer", "minimum": 0 },
        "lastHeartbeat(ms)": { "type": "integer", "minimum": 0 },
        "now(ms)": { "type": "integer", "minimum": 0 }
      }
    },
    "heartbeatContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/heartbeatMemberEntry" }
        }
      }
    },
    "networkThreadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames-percentage",
        "frames",
        "priority-frames-percentage",
        "priority-frames",
        "bytes-percentage",
        "bytes",
        "events-percentage",
        "events",
        "handle-count-percentage",
        "handle-count",
        "tasks-percentage",
        "tasks"
      ],
      "properties": {
        "frames-percentage": { "type": "number" },
        "frames": { "type": "integer", "minimum": 0 },
        "priority-frames-percentage": { "type": "number" },
        "priority-frames": { "type": "integer", "minimum": 0 },
        "bytes-percentage": { "type": "number" },
        "bytes": { "type": "integer", "minimum": 0 },
        "events-percentage": { "type": "number" },
        "events": { "type": "integer", "minimum": 0 },
        "handle-count-percentage": { "type": "number" },
        "handle-count": { "type": "integer", "minimum": 0 },
        "tasks-percentage": { "type": "number" },
        "tasks": { "type": "integer", "minimum": 0 }
      }
    },
    "networkThreadsSection": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/networkThreadEntry" }
      }
    },
    "networkingImbalanceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["InputThreads", "OutputThreads"],
      "properties": {
        "InputThreads": { "$ref": "#/$defs/networkThreadsSection" },
        "OutputThreads": { "$ref": "#/$defs/networkThreadsSection" }
      }
    },
    "overloadedConnectionSampleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionType", "sampleCount", "percentage"],
      "properties": {
        "connectionType": { "type": "string" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "overloadedConnectionSamplesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overloadedConnectionSampleEntry" }
        }
      }
    },
    "overloadedConnectionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "sampleCount", "samples"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "urgentPacketCount": { "type": "integer", "minimum": 0 },
        "packetCount": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "samples": { "$ref": "#/$defs/overloadedConnectionSamplesSection" }
      },
      "oneOf": [
        {
          "required": ["packetCount"],
          "not": { "required": ["urgentPacketCount"] }
        },
        {
          "required": ["urgentPacketCount"],
          "not": { "required": ["packetCount"] }
        }
      ]
    },
    "overloadedConnectionsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection"],
      "properties": {
        "connection": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overloadedConnectionEntry" }
        }
      }
    },
    "latencyByOperationContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/latencyEntry" }
      }
    },
    "threadSampleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "samples", "percentage"],
      "properties": {
        "operation": { "type": "string" },
        "samples": { "type": "integer", "minimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "threadSamplesSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/threadSampleEntry" }
        }
      }
    },
    "operationThreadSamplesContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Partition", "Generic"],
      "properties": {
        "Partition": { "$ref": "#/$defs/threadSamplesSection" },
        "Generic": { "$ref": "#/$defs/threadSamplesSection" }
      }
    },
    "memberAddressEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": { "type": "string" }
      }
    },
    "memberAddressSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/memberAddressEntry" }
        }
      }
    },
    "hazelcastInstanceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thisAddress",
        "isRunning",
        "isLite",
        "joined",
        "nodeState",
        "clusterId",
        "clusterSize",
        "isMaster",
        "masterAddress",
        "Members"
      ],
      "properties": {
        "thisAddress": { "type": "string" },
        "isRunning": { "type": "boolean" },
        "isLite": { "type": "boolean" },
        "joined": { "type": "boolean" },
        "nodeState": {
          "type": "string",
          "enum": ["ACTIVE", "PASSIVE", "SHUTTING_DOWN", "SHUT_DOWN", "null"]
        },
        "clusterId": { "type": "string" },
        "clusterSize": { "type": "integer", "minimum": 0 },
        "isMaster": { "type": "boolean" },
        "masterAddress": { "type": "string" },
        "Members": { "$ref": "#/$defs/memberAddressSection" }
      }
    },
    "pendingInvocationSampleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "duration", "unit"],
      "properties": {
        "description": { "type": "string" },
        "duration": { "type": "integer", "minimum": 0 },
        "unit": { "const": "ms" }
      }
    },
    "sampleHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "samples"],
      "properties": {
        "operation": { "type": "string" },
        "samples": { "type": "integer", "minimum": 0 }
      }
    },
    "pendingSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/pendingInvocationSampleEntry" },
              { "$ref": "#/$defs/textEntry" }
            ]
          }
        }
      }
    },
    "sampleHistorySection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sampleHistoryEntry" }
        }
      }
    },
    "invocationsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Pending", "History", "SlowHistory"],
      "properties": {
        "Pending": { "$ref": "#/$defs/pendingSection" },
        "History": { "$ref": "#/$defs/sampleHistorySection" },
        "SlowHistory": { "$ref": "#/$defs/sampleHistorySection" }
      }
    },
    "storeLatencyMethodEntry": {
      "$ref": "#/$defs/latencyEntry"
    },
    "storeLatencyDataStructureEntry": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/storeLatencyMethodEntry" }
      }
    },
    "storeLatencyContent": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": { "$ref": "#/$defs/storeLatencyDataStructureEntry" }
      }
    }
  }
}
